# /opt/kiddietube/.env  (chmod 600; never commit the real file)
NODE_ENV=production
HOST=127.0.0.1
PORT=3007
BASE_URL=https://kids.tinyapps.dev

# Dedicated, ordinary database user (NOT a superuser, NOT crmuser):
# the API refuses to start as a role that could bypass row-level security.
DATABASE_URL=postgres://kiddietube:CHANGE_ME@127.0.0.1:5432/kiddietube

# 32+ random characters: openssl rand -base64 48
AUTH_SECRET=CHANGE_ME

# Email via Resend (same account as EmlakPro); tinyapps.dev must be verified there
RESEND_API_KEY=CHANGE_ME
# Values with spaces or <> must be in double quotes (systemd and Node accept them)
EMAIL_FROM="Kiddie Tube <noreply@tinyapps.dev>"

# Instance administrators (can invite families), comma-separated
ADMIN_EMAILS=mehmetuyman@gmail.com

# Only nginx on this machine may set X-Forwarded-For (never "true")
TRUST_PROXY=127.0.0.1
LOG_LEVEL=info
