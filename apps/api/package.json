{
  "name": "@kiddietube/api",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "import": "tsx src/scripts/import-list.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@kiddietube/shared": "*",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.16.0",
    "resend": "^6.12.4",
    "tsx": "^4.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.1.6",
    "vitest": "^5.1.0"
  }
}
