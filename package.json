{
  "name": "kiddietube",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @kiddietube/web",
    "build": "npm run build -w @kiddietube/web",
    "preview": "npm run preview -w @kiddietube/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.19"
  }
}
